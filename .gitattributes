# 全部文本文件统一 LF —— Windows 上默认会转成 CRLF，
# 而 Makefile / .sh / .xm 到 macOS runner 上带 CRLF 会直接编译失败。
* text=auto eol=lf

# 明确二进制，别让 git 做任何换行转换
*.png  binary
*.jpg  binary
*.deb  binary
*.dylib binary
*.zip  binary

# 语法高亮识别（.xm 是 Logos）
*.xm   text
*.xmi  text

# GitHub Actions 工作流必须是 LF
.github/workflows/*.yml text eol=lf
